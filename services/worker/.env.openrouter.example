# Copy this file to services/worker/.env. Never commit the filled .env.
# Supabase > Connect: direct or SESSION pooler (5432), not transaction pooler (6543).
DATABASE_URL=your-supabase-postgres-session-connection-url
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
QDRANT_URL=https://CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
# An embedding-model fingerprint and actual dimensions are appended automatically.
QDRANT_COLLECTION=learnstep
AI_PROVIDER=openrouter
CHAT_FALLBACK_PROVIDER=none
OPENROUTER_API_KEY=your-openrouter-api-key
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
# Optional: uncomment to rank the authorized retrieval candidates before generation.
# RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b:free
RERANK_MODEL=
# At most ~18 requests/minute per worker. Other apps sharing the key also consume quota.
OPENROUTER_REQUEST_INTERVAL=3.2
TOKENIZER_MODEL=Qwen/Qwen3-4B
TOKENIZER_PATH=
# Starting point only: recalibrate with the evaluation set for NVIDIA embeddings.
RETRIEVAL_MIN_SCORE=0.35
