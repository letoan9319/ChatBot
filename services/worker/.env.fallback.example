# Copy to services/worker/.env. Secrets stay on the worker; never commit that .env.
# Use the Supabase direct connection or SESSION pooler (5432), with SSL.
DATABASE_URL=your-supabase-postgres-session-connection-url
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
QDRANT_URL=https://CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=study_bge_m3_v1
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
CHAT_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_REQUEST_INTERVAL=3.2
# Rerank is disabled: this configuration only falls back for answer generation.
RERANK_MODEL=
TOKENIZER_MODEL=Qwen/Qwen3-4B
TOKENIZER_PATH=
RETRIEVAL_MIN_SCORE=0.35
