# Use the Supabase direct connection or SESSION pooler on port 5432, not transaction pooler 6543.
# URL-encode the password. Keep sslmode=require for hosted Supabase.
# Copy your full connection string from Supabase > Connect into the local .env.
DATABASE_URL=your-supabase-postgres-session-connection-url
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
QDRANT_URL=https://CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=study_bge_m3_v1
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3:4b
EMBED_MODEL=bge-m3
TOKENIZER_MODEL=Qwen/Qwen3-4B
# Optional: use a local tokenizer.json for offline startup after downloading it once.
TOKENIZER_PATH=
RETRIEVAL_MIN_SCORE=0.35
# OpenRouter alternative: see docs/openrouter.md and .env.openrouter.example.
# No OpenRouter key is needed when AI_PROVIDER=ollama.
