NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Optional Render fallback. Configure both on the server.
# CLOUD_WORKER_URL=https://learnstep-fallback.onrender.com
# WORKER_WAKE_SECRET=

# Use the Supabase direct connection or SESSION pooler on port 5432, not transaction pooler 6543.
# URL-encode the password. Keep sslmode=require for hosted Supabase.
# Copy your full connection string from Supabase > Connect into the local .env.
DATABASE_URL=your-supabase-postgres-session-connection-url
SUPABASE_URL=https://PROJECT.supabase.co
QDRANT_URL=https://CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=study_bge_m3_v1
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Experimental Vietnamese text OCR: PDF_PARSER=paddleocr_text (requires PaddleOCR).
# Set PADDLE_OCR_DEVICE=gpu:0 to use a CUDA-enabled Paddle installation.
# For Vietnamese OCR on CPU, use PDF_PARSER=tesseract_vi.
# Install Tesseract with vie.traineddata and set TESSDATA_PREFIX to its directory.
# Set TESSERACT_EXECUTABLE if tesseract is not on PATH.
# Local PaddleOCR-VL 1.6 GGUF: PDF_PARSER=paddleocr_q4.
# Set OCR_LLAMA_SERVER, OCR_GGUF_MODEL and OCR_GGUF_MMPROJ to absolute file paths.
PDF_PARSER=native
OCR_MODEL=hf.co/bartowski/allenai_olmOCR-2-7B-1025-GGUF:Q4_K_M
CHAT_MODEL=qwen3.5:4b-q4_K_M
EMBED_MODEL=bge-m3
TOKENIZER_MODEL=Qwen/Qwen3-4B
# Optional: use a local tokenizer.json for offline startup after downloading it once.
TOKENIZER_PATH=
RETRIEVAL_MIN_SCORE=0.35
# OpenRouter alternative: see docs/openrouter.md and .env.openrouter.example.
# Optional chat fallback. BGE embedding stays on Ollama; no NVIDIA embeddings/rerank.
CHAT_FALLBACK_PROVIDER=none
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
# OPENROUTER_REQUEST_INTERVAL=3.2

# Optional external services. Configure Render and Vercel separately when deployed.
OPENROUTER_API_KEY=
DEPLOY_API_KEY=
CLOUD_WORKER_URL=
WORKER_WAKE_SECRET=

# Self-hosted web search endpoint.
SEARXNG_URL=http://127.0.0.1:8888
