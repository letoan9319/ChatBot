NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Server-only token from the private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional Cloudflare R2 object storage (enables R2 with hard 90% free-tier safety caps).
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET=learnstep-documents
# R2_ACCESS_KEY_ID=server-only-r2-access-key-id
# R2_SECRET_ACCESS_KEY=server-only-r2-secret-access-key
