@startuml
!include style.iuml
left to right direction
skinparam ArrowColor #334155
skinparam ArrowThickness 1.5
skinparam actorBorderColor #273340
actor "Người học\n(đã đăng nhập)" as L
rectangle "LearnStep — Tài liệu chung" {
 usecase "CH-01\nXem danh mục tài liệu chung" as list
 usecase "CH-02\nTra cứu tài liệu chung" as search
 usecase "CH-03\nXem chi tiết tài liệu chung" as detail
 usecase "CH-04\nĐọc tệp gốc đã công bố" as read
 usecase "CH-05\nChọn nguồn chung cho câu hỏi" as choose
}
L --> list
L --> search
L --> detail
L --> read
L --> choose
@enduml
