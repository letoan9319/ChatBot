@startuml
!include style.iuml
left to right direction
actor "Người học\n(đã đăng nhập)" as learner
rectangle "LearnStep — nhóm học tập và hoạt động học" {
 usecase "Tìm nhóm theo môn" as discover
 usecase "Tạo nhóm học" as create
 usecase "Tham gia nhóm" as join
 usecase "Rời nhóm" as leave
 usecase "Đọc tin nhắn nhóm" as read
 usecase "Gửi tin nhắn nhóm" as post
 usecase "Xem thông báo" as list
 usecase "Đánh dấu thông báo đã đọc" as mark
 usecase "Xem chuỗi ngày học" as streak
}
learner -- discover
learner -- create
learner -- join
learner -- leave
learner -- read
learner -- post
learner -- list
learner -- mark
learner -- streak
@enduml
