@startuml
!include style.iuml
left to right direction
actor "Người học\n(đã đăng nhập)" as learner
rectangle "LearnStep — kho tài liệu và hỏi đáp" {
 usecase "Tìm tài liệu" as search
 usecase "Xem tài liệu chung" as shared
 usecase "Xem tài liệu của tôi" as own
 usecase "Tải tài liệu cá nhân lên" as upload
 usecase "Thử xử lý lại tài liệu lỗi" as retry
 usecase "Xóa tài liệu của tôi" as delete
 usecase "Đọc tài liệu gốc" as read
 usecase "Hỏi đáp theo tài liệu đã chọn" as ask
 usecase "Đối chiếu trích dẫn" as cite
 usecase "Xem lại hội thoại" as history
}
learner -- search
learner -- shared
learner -- own
learner -- upload
learner -- retry
learner -- delete
learner -- read
learner -- ask
learner -- cite
learner -- history
@enduml
