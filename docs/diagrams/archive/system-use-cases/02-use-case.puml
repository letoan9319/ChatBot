@startuml
!include style.iuml
left to right direction
actor "Khách truy cập" as guest
actor "Người học\n(đã đăng nhập)" as learner
rectangle "LearnStep — mục tiêu người sử dụng" {
 usecase "Đăng ký tài khoản" as signup
 usecase "Đăng nhập" as login
 usecase "Khôi phục mật khẩu" as recover
 usecase "Hoàn tất hồ sơ ban đầu" as profile
 usecase "Tra cứu tài liệu" as library
 usecase "Quản lý tài liệu cá nhân" as documents
 usecase "Hỏi đáp theo tài liệu" as ask
 usecase "Xem lại hội thoại" as history
 usecase "Xem hoạt động học" as activity
 usecase "Trao đổi trong nhóm học" as groups
 usecase "Xem thông báo" as notification
 usecase "Tùy chỉnh trải nghiệm học" as settings
 usecase "Đăng xuất" as logout
}
guest -- signup
guest -- login
guest -- recover
learner -- profile
learner -- library
learner -- documents
learner -- ask
learner -- history
learner -- activity
learner -- groups
learner -- notification
learner -- settings
learner -- logout
@enduml
